# Public browser configuration. Use a separate Supabase project for write tests.
# Copy to .env.local, then replace both values with the same staging project's values.
VITE_SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_STAGING_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Never use service_role, a secret key, or a database password in VITE_* variables.
